#include <iostream>
using namespace std;

class Estudiante {
public:
    string nombre;
    string carrera;
    int edad;

    void mostrarDatos() {
        cout << "Nombre: " << nombre
             << " Carrera: " << carrera
             << " Edad: " << edad << endl;
    }
};

int main() {
    Estudiante e1;

    e1.nombre = "Ana";
    e1.carrera = "Ingenieria";
    e1.edad = 20;

    e1.mostrarDatos();

    return 0;
}