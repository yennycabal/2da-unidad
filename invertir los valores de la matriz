/* invertir los valores de la matriz   */

#include<iostream>
using namespace std;
 int main ()
 {
    
    int a[]={10,20,30,40,50};
    
    int c[5];
    
    for(int i=4;i>=0;i--){
        c[i]=a[i];
    }
    for(int i=4;i>=0;i--){
         cout<<c[i]<<", ";
         
    }
    
    return 0;
    
    }
    
    
