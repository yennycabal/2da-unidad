/********************************************************************
potencia en recursividad
*******************************************************************************/
#include<iostream>
using namespace std;

long long potencia(int b,int e)
{
    double r=1;
    for(int i=1;i<=e;i++){
        r=r*b;
    }
      return r;
    }
int main(){
    int b,e;
    cin>>b>>e;
    cout<<potencia(b,e);
    return 0;
}